# Base URL includes any API prefix, e.g. http://localhost:8002/v1
LLM_BASE_URL=http://localhost:8002/v1
LLM_MODEL=your-model-id
LLM_API_KEY=
LIVE_REASONING_ENABLED=true
LIVE_REASONING_TIMEOUT_SEC=60
# Base directory; the demo writes only inside demo/candidates/.
DATA_DIR=data

# Optional user-hosted services; see README for their HTTP contracts.
SPEECH_ENABLED=false
STT_BASE_URL=
STT_API_KEY=
TTS_BASE_URL=
TTS_API_KEY=
SPEECH_TIMEOUT_SEC=60
