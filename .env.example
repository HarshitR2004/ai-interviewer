# Direct Google Gemini API (OpenAI-compatible REST endpoint).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
LIVE_REASONING_TIMEOUT_SEC=8
# Base directory; the demo writes only inside demo/candidates/.
DATA_DIR=data

# Local development only: LiveKit --dev uses these credentials.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_SECRET=local-interview-agent-change-me
BACKEND_URL=http://127.0.0.1:8000
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
LIVE_LLM_MODEL=gemini-3.5-flash-lite
MIN_ENDPOINT_DELAY=0
MAX_ENDPOINT_DELAY=0
INTERRUPTION_DURATION=0.4
